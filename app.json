{
  "expo": {
    "name": "Faltchatt-mobilapp",
    "slug": "Faltchatt-mobilapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "faltchattmobilapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.tf64.faltchatt",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Fältchatt kan dela din position med vald grupp även när appen ligger i bakgrunden eller skärmen är låst, om du själv aktiverar bakgrundsdelning.",
        "NSLocationWhenInUseUsageDescription": "Fältchatt använder din position för att visa dig på kartan och dela din position med medlemmar i den grupp du har valt.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.tf64.faltchatt"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Fältchatt behöver platsåtkomst för att visa och dela din position med vald grupp. Om du aktiverar bakgrundsdelning kan positionen delas även när appen ligger i bakgrunden eller skärmen är låst.",
          "locationWhenInUsePermission": "Fältchatt använder din position för att visa dig på kartan och dela din position med medlemmar i den grupp du har valt."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash.png",
          "imageWidth": 220
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c94f4eb8-b94e-4691-a7fa-b40047f8071b"
      }
    }
  }
}
